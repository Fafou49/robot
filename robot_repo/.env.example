# Copy this file to ".env" (same folder, repo root) and fill in real values.
# ".env" is already excluded by .gitignore and must never be committed.

# NTRIP / DGPS correction stream (used by gps/dgps_transfer.py)
# Defaults below are the public Centipede test account (crtk.net).
NTRIP_CASTER=crtk.net
NTRIP_PORT=2101
NTRIP_MOUNTPOINT=NEAR
NTRIP_USER=centipede
NTRIP_PASSWORD=centipede

# Live camera stream (used by camera/stream_server.py, run via
# `python3 -m camera`). CAMERA_DEVICE is the only one usually needed --
# find the right value with `ls /dev/video*` and, if there's more than
# one node, `v4l2-ctl --list-devices` / `v4l2-ctl --list-formats-ext -d
# /dev/videoX` (the capture-capable node lists MJPG/YUYV formats; a UVC
# webcam often also exposes a second, metadata-only node that won't work
# here). Leave the others commented out to keep their built-in defaults.
CAMERA_DEVICE=/dev/video0
#CAMERA_WIDTH=640
#CAMERA_HEIGHT=480
#CAMERA_FPS=15
#CAMERA_HOST=0.0.0.0
#CAMERA_PORT=8000
#CAMERA_SNAPSHOT_DIR=camera/tmp

# Gamepad control (used by link/server.py, run via `python3 -m link`).
# Only needed if this project's actual controller/receiver reports a
# button under a different evdev code than the "standard" Xbox mapping
# assumes -- run `python3 -m motor_control.dump_gamepad_buttons` on the
# Pi to find out empirically, then uncomment and fix the one(s) that are
# wrong. Leave all commented out to keep the defaults (BTN_Y/BTN_B/
# BTN_START).
#GAMEPAD_ARM_AUTO_BTN=BTN_Y
#GAMEPAD_STOP_BTN=BTN_B
#GAMEPAD_SHUTDOWN_BTN=BTN_START

# What BTN_START (see above) runs to power off the Raspberry Pi -- see
# link/server.py's ControlServer._shutdown_pi(). Requires passwordless
# sudo for whichever user runs run_robot.sh, see README.md ("Pilotage
# moteur et manette").
#SHUTDOWN_CMD=sudo poweroff
