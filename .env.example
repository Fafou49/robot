# Copy this file to ".env" (same folder, repo root) and fill in real values.
# ".env" is already excluded by .gitignore and must never be committed.

# NTRIP / DGPS correction stream (used by gps/dgps_transfer.py)
# Defaults below are the public Centipede test account (crtk.net).
NTRIP_CASTER=crtk.net
NTRIP_PORT=2101
NTRIP_MOUNTPOINT=NEAR
NTRIP_USER=centipede
NTRIP_PASSWORD=centipede
